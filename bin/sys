#!/usr/bin/env bash

main() {

  options=(
    "List failed system services"
    "Update pacman mirrorlist"
    "Clean pacman package cache"
    "Remove orphans"
    "Clear ~/.cache"
    "Vacuum systemd journal"
    "Exit"
  )

  PS3="Select an option: "
  select opt in "${options[@]}"
  do
    case $opt in
      "List failed system services")
        systemctl --failed
        break
        ;;
      "Update pacman mirrorlist")
        sudo systemctl start reflector.serivce
        break
        ;;
      "Clean pacman package cache")
        sudo pacman -Scc
        break
        ;;
      "Remove orphans")
        sudo pacman -Rns $(pacman -Qtdq)
        break
        ;;
      "Clear ~/.cache")
        sudo rm -rf $HOME/.cache/*
        break
        ;;
      "Vacuum systemd journal")
        sudo journalctl --vacuum-time=2weeks
        break
        ;;
      "Exit")
        echo "Exiting..."
        break
        ;;
      *)
        echo "Invalid option: $REPLY"
        ;;
    esac
  done

}

main
